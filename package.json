{
  "name": "sdlc-demo-sso",
  "version": "1.0.0",
  "description": "Enterprise SSO Integration with Identity Provider",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@node-saml/passport-saml": "5.1.0",
    "csrf-csrf": "^3.0.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "9.0.2",
    "jwks-rsa": "3.1.0",
    "node-cron": "3.0.3",
    "openid-client": "5.6.4",
    "passport": "0.7.0",
    "uuid": "9.0.1",
    "winston": "3.11.0"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "supertest": "6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
